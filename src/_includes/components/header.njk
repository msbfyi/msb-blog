{% set navItems = collections.all | eleventyNavigation %}
<div class="wrap">
<header class="ident" role="banner">
{% msbLockup "MSB", ".fyi", "Michael Sean Becker" %}
<span class="sp"></span>
<div class="tog" role="group" aria-label="Colour mode">
<button type="button" data-mode="light" aria-pressed="false">Light</button>
<button type="button" data-mode="auto" aria-pressed="true">Auto</button>
<button type="button" data-mode="dark" aria-pressed="false">Dark</button>
</div>
</header>
</div>

<nav class="rail" role="navigation" aria-label="main navigation">
<div class="wrap"><div class="rail-in">
{%- for item in navItems %}
<a href="{{ item.url }}" class="{{ 'on' if page.url === item.url }}">{{ item.key }}</a>
{%- endfor -%}
</div></div>
</nav>
